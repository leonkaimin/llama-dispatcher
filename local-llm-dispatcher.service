[Unit]
Description=Local LLM Dispatcher for OpenClaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=local-llm-dispatcher
Group=local-llm-dispatcher
WorkingDirectory=/opt/local-llm-dispatcher
EnvironmentFile=-/etc/default/local-llm-dispatcher
Environment=LLAMA_DISPATCHER_CONFIG=/etc/local-llm-dispatcher/dispatcher-config.json
Environment=LOCAL_LLM_DISPATCHER_HOST=127.0.0.1
Environment=LOCAL_LLM_DISPATCHER_PORT=8090
ExecStart=/opt/local-llm-dispatcher/.venv/bin/uvicorn dispatcher:app --host ${LOCAL_LLM_DISPATCHER_HOST} --port ${LOCAL_LLM_DISPATCHER_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
